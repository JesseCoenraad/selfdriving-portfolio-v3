<launch>
  <arg name="veh" default="$(env VEHICLE_NAME)" />

  <node
    pkg="localization"
    type="localization_node.py"
    name="localization_node"
    ns="$(arg veh)"
    output="screen"
  >
    <rosparam command="load"
              file="$(find localization)/config/params.yaml" />
  </node>
</launch>